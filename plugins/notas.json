{
  "schema": 5,
  "id": "plugin.exemplo.notas",
  "name": "Notas",
  "interval": 600,
  "icon": {
    "kind": "symbol",
    "symbolName": "note.text"
  },
  "source": {
    "kind": "script",
    "language": "applescript",
    "script": "set saida to \"titulo\" & tab & \"quando\"\ntell application \"Notes\"\n\trepeat with n in (notes of folder \"{{$settings.pasta}}\")\n\t\tset saida to saida & linefeed & (name of n) & tab & (short date string of (modification date of n))\n\tend repeat\nend tell\nreturn saida",
    "format": {
      "kind": "columns",
      "separator": "tab",
      "hasHeader": true
    }
  },
  "slot": {
    "label": "{{rows | count}}",
    "style": "number"
  },
  "card": {
    "isEnabled": true,
    "title": "Notas",
    "subtitle": "{{$settings.pasta}}",
    "emptyMessage": "Nenhuma nota nessa pasta.",
    "blocks": [
      {
        "type": "list",
        "limit": 8,
        "tabs": [
          {
            "title": "Notas",
            "path": "rows[*]",
            "rowTitle": "{{titulo}}",
            "rowSubtitle": "{{quando}}",
            "rowWrapsTitle": true,
            "rowEvent": "none"
          }
        ]
      }
    ]
  },
  "actions": [
    {
      "name": "Abrir o Notas",
      "symbolName": "arrow.up.forward.app",
      "place": "card",
      "run": {
        "kind": "onTheMac",
        "errand": "openApp",
        "text": "com.apple.Notes"
      },
      "successReport": "nothing"
    }
  ],
  "attention": {
    "mode": "newRows"
  },
  "settings": [
    {
      "key": "pasta",
      "label": "Pasta",
      "type": "text",
      "default": "Notas",
      "help": "O nome exato de uma pasta no app Notas.",
      "required": true
    }
  ]
}
