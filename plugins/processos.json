{
  "schema": 4,
  "id": "plugin.exemplo.processos",
  "name": "Processos",
  "interval": 60,
  "icon": {
    "kind": "symbol",
    "symbolName": "gauge.with.dots.needle.67percent"
  },
  "source": {
    "kind": "command",
    "steps": [
      {
        "program": "/bin/ps",
        "arguments": [
          "-Aceo",
          "pcpu,pmem,comm",
          "-r"
        ]
      }
    ],
    "format": {
      "kind": "regex",
      "pattern": "(?m)^\\s*(?<cpu>[\\d.,]+)\\s+(?<mem>[\\d.,]+)\\s+(?<nome>.+?)\\s*$",
      "all": true
    }
  },
  "slot": {
    "label": "{{matches[0].cpu}}%",
    "value": "{{matches[0].cpu}}",
    "total": "100",
    "style": "arc"
  },
  "card": {
    "isEnabled": true,
    "title": "Processos",
    "subtitle": "Quem está comendo a CPU agora",
    "blocks": [
      {
        "type": "bars",
        "title": "CPU por processo",
        "path": "matches",
        "label": "{{nome}}",
        "value": "{{cpu}}",
        "limit": 6,
        "format": "number"
      },
      {
        "type": "table",
        "path": "matches",
        "sortable": true,
        "limit": 10,
        "rowEvent": "none",
        "columns": [
          {
            "title": "Processo",
            "kind": "text",
            "value": "{{nome}}",
            "align": "leading"
          },
          {
            "title": "CPU %",
            "kind": "text",
            "value": "{{cpu}}",
            "align": "trailing",
            "format": "number"
          },
          {
            "title": "Memória %",
            "kind": "text",
            "value": "{{mem}}",
            "align": "trailing",
            "format": "number"
          }
        ]
      }
    ]
  },
  "actions": [
    {
      "name": "Abrir o Monitor de Atividade",
      "symbolName": "arrow.up.forward.app",
      "place": "card",
      "run": {
        "kind": "onTheMac",
        "errand": "openApp",
        "text": "com.apple.ActivityMonitor"
      },
      "successReport": "nothing"
    }
  ],
  "attention": {
    "mode": "never"
  }
}
