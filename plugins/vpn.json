{
  "schema": 4,
  "id": "plugin.exemplo.vpn",
  "name": "VPN",
  "interval": 120,
  "icon": {
    "kind": "symbol",
    "symbolName": "lock.shield.fill"
  },
  "source": {
    "kind": "command",
    "steps": [
      {
        "program": "/usr/sbin/scutil",
        "arguments": [
          "--nc",
          "list"
        ]
      }
    ],
    "format": {
      "kind": "regex",
      "all": true,
      "pattern": "\\((?<situacao>Connected|Disconnected|Connecting|Disconnecting)\\)\\s+\\S+\\s+(?<tipo>\\S+)\\s+-->\\s+(?<nome>.+?)\\s*(?:\\[|$)"
    }
  },
  "slot": {
    "label": "{{matches | count}}",
    "style": "number"
  },
  "card": {
    "isEnabled": true,
    "title": "VPN",
    "subtitle": "As conexões deste Mac",
    "emptyMessage": "Nenhuma conexão de rede configurada.",
    "blocks": [
      {
        "type": "grid",
        "path": "matches",
        "label": "{{nome}}",
        "status": "{{situacao}}",
        "limit": 12,
        "statusColors": {
          "Connected": "positive",
          "Connecting": "attention",
          "Disconnecting": "attention",
          "Disconnected": "neutral"
        }
      },
      {
        "type": "table",
        "path": "matches",
        "sortable": true,
        "limit": 10,
        "rowEvent": "none",
        "columns": [
          {
            "title": "Conexão",
            "kind": "text",
            "value": "{{nome}}",
            "align": "leading"
          },
          {
            "title": "Tipo",
            "kind": "text",
            "value": "{{tipo}}",
            "align": "leading"
          },
          {
            "title": "",
            "kind": "status",
            "value": "{{situacao}}",
            "align": "trailing",
            "statusColors": {
              "Connected": "positive",
              "Disconnected": "neutral"
            },
            "showsWord": true
          }
        ]
      }
    ]
  },
  "actions": [],
  "attention": {
    "mode": "never"
  }
}
