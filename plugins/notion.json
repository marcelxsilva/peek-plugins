{
  "schema": 11,
  "id": "plugin.exemplo.notion",
  "name": "Notion",
  "interval": 600,
  "icon": {
    "kind": "symbol",
    "symbolName": "doc.text.fill"
  },
  "source": {
    "kind": "http",
    "method": "POST",
    "url": "https://api.notion.com/v1/databases/{{$settings.base}}/query",
    "headers": [
      {
        "name": "Authorization",
        "value": "Bearer {{secret}}"
      },
      {
        "name": "Notion-Version",
        "value": "2022-06-28"
      },
      {
        "name": "Content-Type",
        "value": "application/json"
      }
    ],
    "body": "{\"page_size\": 12}",
    "format": {
      "kind": "json"
    }
  },
  "slot": {
    "label": "{{results | count}}",
    "style": "number"
  },
  "card": {
    "isEnabled": true,
    "title": "Notion",
    "subtitle": "Itens do banco de dados",
    "emptyMessage": "Nada neste banco, ou a integração não tem acesso a ele.",
    "blocks": [
      {
        "type": "breakdown",
        "title": "Por status",
        "breakdownStyle": "bar",
        "path": "results",
        "groupField": "{{properties.Status.status.name}}",
        "groupKind": "text",
        "measure": "count",
        "shows": "both",
        "groups": [
          {
            "id": "CF902951-F428-4C9F-AAA8-B8ED93AD4DAB",
            "name": "Não iniciado",
            "color": "gray",
            "match": "Not started, Não iniciado"
          },
          {
            "id": "1E0ABDC7-454E-4DE7-82B6-5907E407D871",
            "name": "Em andamento",
            "color": "blue",
            "match": "In progress, Em andamento"
          },
          {
            "id": "0E9C7EAB-D34A-4117-99D3-847C181B516A",
            "name": "Concluído",
            "color": "green",
            "match": "Done, Concluído"
          }
        ],
        "others": {
          "shows": true,
          "name": "Outros",
          "color": "purple"
        }
      },
      {
        "type": "list",
        "limit": 6,
        "tabs": [
          {
            "title": "Itens",
            "path": "results",
            "rowTitle": "{{properties.Name.title[0].plain_text}}",
            "rowSubtitle": "{{properties.Date.date.start | date}}",
            "rowMeta": "Editado {{last_edited_time | ago}}",
            "rowStatus": "{{properties.Status.status.name}}",
            "rowWrapsTitle": true,
            "rowURL": "{{url}}"
          }
        ]
      }
    ]
  },
  "actions": [],
  "attention": {
    "mode": "newRows"
  },
  "settings": [
    {
      "key": "base",
      "label": "ID do banco de dados",
      "type": "text",
      "help": "O trecho de 32 caracteres da URL do banco. Compartilhe o banco com a sua integração antes, senão a chamada volta 404. As linhas leem as propriedades Name, Status e Date; renomeie nos campos da linha se as suas tiverem outro nome.",
      "required": true
    }
  ]
}
