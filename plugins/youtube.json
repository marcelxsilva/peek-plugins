{
  "schema": 8,
  "id": "plugin.exemplo.youtube",
  "name": "YouTube",
  "interval": 3600,
  "icon": {
    "kind": "picture",
    "pictureSource": "{{items[0].snippet.thumbnails.default.url}}"
  },
  "source": {
    "kind": "http",
    "method": "GET",
    "url": "https://www.googleapis.com/youtube/v3/channels",
    "query": [
      {
        "name": "part",
        "value": "snippet,statistics"
      },
      {
        "name": "id",
        "value": "{{$settings.canal}}"
      },
      {
        "name": "key",
        "value": "{{secret}}"
      }
    ],
    "format": {
      "kind": "json"
    }
  },
  "slot": {
    "label": "{{items[0].statistics.subscriberCount}}",
    "style": "sparkline"
  },
  "history": {
    "path": "items[0].statistics.subscriberCount",
    "keep": 192
  },
  "card": {
    "isEnabled": true,
    "picture": {
      "kind": "address",
      "value": "{{items[0].snippet.thumbnails.medium.url}}",
      "shape": "round"
    },
    "title": "{{items[0].snippet.title}}",
    "subtitle": "{{items[0].statistics.videoCount}} vídeos publicados",
    "emptyMessage": "Canal não encontrado. Confira o ID e a chave.",
    "blocks": [
      {
        "type": "hero",
        "value": "{{items[0].statistics.subscriberCount}}",
        "caption": "Inscritos",
        "format": "compact",
        "goodDirection": "up",
        "width": "half"
      },
      {
        "type": "hero",
        "width": "half",
        "value": "{{items[0].statistics.viewCount}}",
        "caption": "Visualizações no total",
        "format": "compact",
        "goodDirection": "up"
      },
      {
        "type": "chart",
        "title": "Inscritos ao longo do tempo",
        "style": "line",
        "height": "medium",
        "format": "compact"
      }
    ]
  },
  "actions": [
    {
      "name": "Abrir o canal",
      "symbolName": "arrow.up.forward.square",
      "place": "card",
      "run": {
        "kind": "onTheMac",
        "errand": "openLink",
        "text": "https://www.youtube.com/channel/{{$settings.canal}}"
      },
      "successReport": "nothing"
    }
  ],
  "attention": {
    "mode": "never"
  },
  "settings": [
    {
      "key": "canal",
      "label": "ID do canal",
      "type": "text",
      "placeholder": "UC…",
      "help": "Começa com UC. A chave da API do YouTube Data v3 vai no campo de segredo, em Dado.",
      "required": true
    }
  ]
}
