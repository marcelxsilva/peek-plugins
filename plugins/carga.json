{
  "schema": 8,
  "id": "plugin.exemplo.carga",
  "name": "Carga do Mac",
  "interval": 60,
  "icon": {
    "kind": "symbol",
    "symbolName": "speedometer"
  },
  "source": {
    "kind": "command",
    "steps": [
      {
        "program": "/usr/bin/uptime",
        "arguments": []
      }
    ],
    "format": {
      "kind": "regex",
      "pattern": "up (?<tempo>.+), +[0-9]+ users?, load averages: (?<um>[0-9.]+) +(?<cinco>[0-9.]+) +(?<quinze>[0-9.]+)"
    }
  },
  "slot": {
    "label": "{{um}}",
    "value": "{{um}}",
    "total": "8",
    "style": "sparkline"
  },
  "history": {
    "path": "um",
    "keep": 96
  },
  "card": {
    "isEnabled": true,
    "title": "Carga do Mac",
    "subtitle": "Ligado há {{tempo}}",
    "blocks": [
      {
        "type": "hero",
        "value": "{{um}}",
        "caption": "Média do último minuto",
        "format": "number",
        "goodDirection": "down",
        "width": "half"
      },
      {
        "type": "properties",
        "layout": "stacked",
        "width": "half",
        "properties": [
          {
            "id": "E44BAF28-40F0-472A-A681-2FFC07DE061C",
            "name": "5 minutos",
            "value": "{{cinco}}"
          },
          {
            "id": "B6F31305-18AC-4496-9F96-5BECEF1D0128",
            "name": "15 minutos",
            "value": "{{quinze}}"
          }
        ]
      },
      {
        "type": "chart",
        "title": "Carga ao longo do tempo",
        "style": "area",
        "height": "medium",
        "format": "number"
      }
    ]
  },
  "actions": [],
  "attention": {
    "mode": "never"
  }
}
