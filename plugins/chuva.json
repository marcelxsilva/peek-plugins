{
  "schema": 8,
  "id": "plugin.exemplo.chuva",
  "name": "Chuva",
  "interval": 900,
  "icon": {
    "kind": "symbol",
    "symbolName": "cloud.rain.fill"
  },
  "source": {
    "kind": "http",
    "method": "GET",
    "url": "https://api.open-meteo.com/v1/forecast?latitude={{$settings.lat}}&longitude={{$settings.lon}}&current=precipitation,rain,precipitation_probability&hourly=precipitation_probability,precipitation&forecast_hours=24&timezone=auto",
    "format": {
      "kind": "json"
    }
  },
  "slot": {
    "label": "{{current.precipitation_probability}}%",
    "value": "{{current.precipitation_probability}}",
    "total": "100",
    "style": "arc",
    "alertsOnThreshold": true
  },
  "card": {
    "isEnabled": true,
    "title": "Chuva",
    "subtitle": "{{timezone}}",
    "blocks": [
      {
        "type": "hero",
        "value": "{{current.precipitation_probability}}",
        "total": "100",
        "caption": "Chance de chuva agora, em %",
        "goodDirection": "down",
        "format": "integer",
        "width": "half"
      },
      {
        "type": "properties",
        "layout": "stacked",
        "width": "half",
        "properties": [
          {
            "id": "9807C2A2-EF5B-4D89-9250-89AD25B52970",
            "name": "Caindo agora",
            "value": "{{current.precipitation}} mm"
          }
        ]
      },
      {
        "type": "chart",
        "style": "area",
        "title": "Chance nas próximas 24 horas (%)",
        "path": "hourly.precipitation_probability",
        "x": "hourly.time",
        "dateFormat": "yyyy-MM-dd'T'HH:mm",
        "height": "medium",
        "format": "integer"
      }
    ]
  },
  "actions": [],
  "attention": {
    "mode": "countAbove",
    "comparison": "above",
    "countPath": "current.precipitation_probability",
    "threshold": "{{$settings.avisar}}"
  },
  "settings": [
    {
      "key": "lat",
      "label": "Latitude",
      "type": "text",
      "default": "-23.55"
    },
    {
      "key": "lon",
      "label": "Longitude",
      "type": "text",
      "default": "-46.63"
    },
    {
      "key": "avisar",
      "label": "Avisar acima de",
      "type": "number",
      "default": 60,
      "help": "Em porcentagem de chance de chuva."
    }
  ]
}
