{
  "schema": 8,
  "id": "plugin.exemplo.brew",
  "name": "Homebrew",
  "interval": 21600,
  "icon": {
    "kind": "picture",
    "symbolName": "shippingbox.fill",
    "pictureSource": "https://github.com/Homebrew.png?size=128"
  },
  "source": {
    "kind": "command",
    "steps": [
      {
        "program": "/usr/bin/env",
        "arguments": [
          "PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin",
          "brew",
          "outdated",
          "--json=v2"
        ]
      }
    ],
    "format": {
      "kind": "json"
    }
  },
  "slot": {
    "label": "{{formulae | count}}",
    "style": "number"
  },
  "card": {
    "isEnabled": true,
    "title": "Homebrew",
    "subtitle": "O que dá para atualizar",
    "emptyMessage": "Tudo atualizado.",
    "blocks": [
      {
        "type": "hero",
        "value": "{{formulae | count}}",
        "caption": "Fórmulas desatualizadas",
        "goodDirection": "down",
        "format": "integer",
        "width": "half"
      },
      {
        "type": "hero",
        "value": "{{casks | count}}",
        "caption": "Casks desatualizados",
        "goodDirection": "down",
        "format": "integer",
        "width": "half"
      },
      {
        "type": "list",
        "limit": 6,
        "tabs": [
          {
            "title": "Fórmulas",
            "path": "formulae",
            "rowTitle": "{{name}}",
            "rowSubtitle": "{{installed_versions[0]}} → {{current_version}}",
            "rowURL": "https://formulae.brew.sh/formula/{{name}}"
          },
          {
            "title": "Casks",
            "path": "casks",
            "rowTitle": "{{name}}",
            "rowSubtitle": "{{installed_versions[0]}} → {{current_version}}",
            "rowURL": "https://formulae.brew.sh/cask/{{name}}"
          }
        ]
      }
    ]
  },
  "actions": [
    {
      "name": "Copiar o comando",
      "symbolName": "doc.on.doc",
      "place": "card",
      "run": {
        "kind": "onTheMac",
        "errand": "copy",
        "text": "brew upgrade"
      },
      "successMessage": "Comando copiado."
    },
    {
      "name": "Copiar o comando",
      "symbolName": "doc.on.doc",
      "place": "row",
      "listIndex": 0,
      "run": {
        "kind": "onTheMac",
        "errand": "copy",
        "text": "brew upgrade {{name}}"
      },
      "successMessage": "Comando copiado."
    },
    {
      "name": "Copiar o comando",
      "symbolName": "doc.on.doc",
      "place": "row",
      "listIndex": 1,
      "run": {
        "kind": "onTheMac",
        "errand": "copy",
        "text": "brew upgrade --cask {{name}}"
      },
      "successMessage": "Comando copiado."
    }
  ],
  "attention": {
    "mode": "newRows"
  }
}
