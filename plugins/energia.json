{
  "schema": 7,
  "id": "plugin.exemplo.energia",
  "name": "Energia",
  "interval": 300,
  "icon": {
    "kind": "symbol",
    "symbolName": "bolt.fill"
  },
  "source": {
    "kind": "http",
    "method": "GET",
    "url": "http://homeassistant.local:8123/api/states/{{$settings.sensor}}",
    "headers": [
      {
        "name": "Authorization",
        "value": "Bearer {{$settings.token}}"
      }
    ],
    "format": {
      "kind": "json"
    }
  },
  "slot": {
    "label": "{{state | round}}",
    "style": "sparkline"
  },
  "history": {
    "path": "state",
    "keep": 192
  },
  "card": {
    "isEnabled": true,
    "title": "Energia",
    "subtitle": "{{attributes.friendly_name}}",
    "emptyMessage": "O Home Assistant não respondeu. Confira o endereço e o token.",
    "blocks": [
      {
        "type": "hero",
        "value": "{{state}}",
        "caption": "{{attributes.unit_of_measurement}} agora · lido {{last_changed | ago}}",
        "goodDirection": "down",
        "format": "number"
      },
      {
        "type": "chart",
        "style": "area",
        "title": "Consumo ao longo do tempo",
        "height": "medium",
        "format": "number"
      }
    ]
  },
  "actions": [],
  "attention": {
    "mode": "never"
  },
  "settings": [
    {
      "key": "sensor",
      "label": "Sensor",
      "type": "text",
      "default": "sensor.consumo_atual",
      "help": "O entity_id do sensor de potência no Home Assistant.",
      "required": true
    },
    {
      "key": "token",
      "label": "Token",
      "type": "secret",
      "required": true,
      "help": "Crie no Home Assistant em Perfil › Segurança › Tokens de acesso de longa duração."
    }
  ],
  "answer": "{\"entity_id\":\"sensor.consumo_atual\",\"state\":\"412.6\",\"attributes\":{\"state_class\":\"measurement\",\"unit_of_measurement\":\"W\",\"device_class\":\"power\",\"friendly_name\":\"Consumo da casa\"},\"last_changed\":\"2026-10-01T12:14:03.218451+00:00\",\"last_reported\":\"2026-10-01T12:14:03.218451+00:00\",\"last_updated\":\"2026-10-01T12:14:03.218451+00:00\",\"context\":{\"id\":\"01J9ZQ4K7M3N8P2R5T6V9W0X1Z\",\"parent_id\":null,\"user_id\":null}}"
}
