{
  "schema": 7,
  "id": "plugin.exemplo.meta",
  "name": "Meta do mês",
  "interval": 3600,
  "readsOnItsOwn": false,
  "icon": {
    "kind": "symbol",
    "symbolName": "flag.checkered"
  },
  "source": {
    "kind": "panel",
    "format": {
      "kind": "json"
    }
  },
  "answer": "{\n  \"mes\": \"Outubro de 2026\",\n  \"meta\": 250000,\n  \"realizado\": 168400,\n  \"dias_restantes\": 9,\n  \"vendedores\": [\n    { \"nome\": \"Ana\", \"valor\": 72000 },\n    { \"nome\": \"Bruno\", \"valor\": 54400 },\n    { \"nome\": \"Carla\", \"valor\": 42000 }\n  ]\n}",
  "slot": {
    "label": "{{realizado | shape #,##0}}",
    "value": "{{realizado}}",
    "total": "{{meta}}",
    "style": "arc",
    "alertsOnThreshold": false
  },
  "card": {
    "isEnabled": true,
    "title": "Meta do mês",
    "subtitle": "{{mes}} · faltam {{dias_restantes}} dias",
    "blocks": [
      {
        "type": "hero",
        "value": "{{realizado}}",
        "total": "{{meta}}",
        "caption": "Vendido até agora, contra a meta do mês",
        "format": "money",
        "currency": "BRL",
        "goodDirection": "up"
      },
      {
        "type": "bars",
        "title": "Por vendedor",
        "path": "vendedores",
        "label": "{{nome}}",
        "value": "{{valor}}",
        "limit": 6,
        "format": "money",
        "currency": "BRL"
      },
      {
        "type": "text",
        "value": "Os números moram no próprio arquivo, na aba **Dado**. Troque por uma fonte de verdade quando o CRM tiver uma API.",
        "maxHeight": "small"
      }
    ]
  },
  "actions": [],
  "attention": {
    "mode": "never"
  }
}
