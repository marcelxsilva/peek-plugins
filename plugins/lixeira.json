{
  "schema": 5,
  "id": "plugin.exemplo.lixeira",
  "name": "Lixeira",
  "interval": 1800,
  "icon": {
    "kind": "symbol",
    "symbolName": "trash.circle.fill"
  },
  "source": {
    "kind": "command",
    "steps": [
      {
        "program": "/usr/bin/find",
        "arguments": [
          "{{$settings.pasta}}",
          "-maxdepth",
          "1",
          "-mindepth",
          "1"
        ]
      }
    ],
    "format": {
      "kind": "files"
    }
  },
  "slot": {
    "label": "{{files | count}}",
    "style": "number"
  },
  "card": {
    "isEnabled": true,
    "title": "Lixeira",
    "subtitle": "O que ainda ocupa espaço",
    "emptyMessage": "Lixeira vazia.",
    "blocks": [
      {
        "type": "hero",
        "value": "{{files | count}}",
        "caption": "Itens esperando para sumir",
        "goodDirection": "down",
        "format": "integer"
      },
      {
        "type": "list",
        "limit": 6,
        "tabs": [
          {
            "title": "Itens",
            "path": "files[*]",
            "rowTitle": "{{name}}",
            "rowSubtitle": "{{size | bytes}}",
            "rowMeta": "{{modified | ago}}",
            "rowWrapsTitle": true,
            "rowEvent": "none"
          }
        ]
      }
    ]
  },
  "actions": [
    {
      "name": "Abrir a Lixeira",
      "symbolName": "arrow.up.forward.app",
      "place": "card",
      "run": {
        "kind": "onTheMac",
        "errand": "openApp",
        "text": "com.apple.finder"
      },
      "successReport": "nothing"
    }
  ],
  "attention": {
    "mode": "never"
  },
  "settings": [
    {
      "key": "pasta",
      "label": "Pasta da Lixeira",
      "type": "text",
      "help": "Caminho absoluto. Aqui não há shell, então nada de ~.",
      "required": true,
      "placeholder": "/Users/voce/.Trash"
    }
  ]
}
