{
  "schema": 2,
  "id": "plugin.exemplo.bateria",
  "name": "Bateria",
  "interval": 120,
  "icon": {
    "kind": "symbol",
    "symbolName": "battery.100percent"
  },
  "source": {
    "kind": "command",
    "steps": [
      {
        "program": "/usr/bin/pmset",
        "arguments": ["-g", "batt"]
      }
    ],
    "format": {
      "kind": "regex",
      "pattern": "from '(?<fonte>[^']+)'[\\s\\S]*?(?<carga>\\d+)%; (?<estado>[^;]+); (?<restante>[^ ]+)"
    }
  },
  "slot": {
    "label": "{{carga}}%",
    "value": "{{carga}}",
    "total": "100",
    "style": "arc",
    "alertsOnThreshold": true
  },
  "history": {
    "path": "carga",
    "keep": 96
  },
  "card": {
    "isEnabled": true,
    "title": "Bateria",
    "subtitle": "{{fonte}}",
    "blocks": [
      {
        "type": "hero",
        "value": "{{carga}}",
        "total": "100",
        "caption": "{{estado}} · {{restante}} restante",
        "format": "integer",
        "goodDirection": "up"
      },
      {
        "type": "chart",
        "title": "Carga ao longo do tempo",
        "style": "line",
        "height": "medium",
        "format": "integer"
      }
    ]
  },
  "actions": [],
  "attention": {
    "mode": "countAbove",
    "comparison": "below",
    "countPath": "carga",
    "threshold": 20
  }
}
