{
  "schema": 5,
  "id": "plugin.exemplo.colar",
  "name": "Colar rápido",
  "interval": 300,
  "readsOnItsOwn": false,
  "icon": {
    "kind": "symbol",
    "symbolName": "doc.on.clipboard.fill"
  },
  "source": {
    "kind": "panel",
    "format": {
      "kind": "json"
    }
  },
  "slot": {
    "label": "",
    "style": "arc"
  },
  "card": {
    "isEnabled": true,
    "title": "Colar rápido",
    "subtitle": "Os textos que você digita toda semana",
    "blocks": [
      {
        "type": "buttons",
        "resultSpot": "below"
      }
    ]
  },
  "actions": [
    {
      "name": "Chave Pix",
      "symbolName": "qrcode",
      "place": "panel",
      "size": "small",
      "titleSpot": "below",
      "hue": "teal",
      "run": {
        "kind": "onTheMac",
        "errand": "copy",
        "text": "{{$settings.pix}}"
      },
      "successMessage": "Chave Pix copiada."
    },
    {
      "name": "Endereço",
      "symbolName": "mappin.and.ellipse",
      "place": "panel",
      "size": "small",
      "titleSpot": "below",
      "hue": "green",
      "run": {
        "kind": "onTheMac",
        "errand": "copy",
        "text": "{{$settings.endereco}}"
      },
      "successMessage": "Endereço copiado."
    },
    {
      "name": "Assinatura",
      "symbolName": "signature",
      "place": "panel",
      "size": "small",
      "titleSpot": "below",
      "hue": "indigo",
      "run": {
        "kind": "onTheMac",
        "errand": "copy",
        "text": "{{$settings.assinatura}}"
      },
      "successMessage": "Assinatura copiada."
    },
    {
      "name": "Guardar o que está copiado",
      "symbolName": "tray.and.arrow.down.fill",
      "place": "panel",
      "size": "large",
      "titleSpot": "inside",
      "hue": "orange",
      "run": {
        "kind": "onTheMac",
        "errand": "remember",
        "variable": "colar_ultimo",
        "text": "{{$clipboard}}"
      },
      "successMessage": "Guardado na variável colar_ultimo."
    },
    {
      "name": "Colar o guardado",
      "symbolName": "arrow.up.doc.on.clipboard",
      "place": "panel",
      "size": "large",
      "titleSpot": "inside",
      "hue": "blue",
      "run": {
        "kind": "onTheMac",
        "errand": "copy",
        "text": "{{$global.colar_ultimo}}"
      },
      "successMessage": "Voltou para a área de transferência."
    }
  ],
  "attention": {
    "mode": "never"
  },
  "settings": [
    {
      "key": "pix",
      "label": "Chave Pix",
      "type": "text",
      "placeholder": "voce@email.com"
    },
    {
      "key": "endereco",
      "label": "Endereço",
      "type": "text",
      "placeholder": "Rua Exemplo, 100 · São Paulo"
    },
    {
      "key": "assinatura",
      "label": "Assinatura de e-mail",
      "type": "text",
      "default": "Atenciosamente,\nSeu nome"
    }
  ]
}
