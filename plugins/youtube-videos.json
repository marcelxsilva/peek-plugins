{
  "schema": 5,
  "id": "plugin.exemplo.youtube-videos",
  "name": "Vídeos",
  "interval": 3600,
  "icon": {
    "kind": "symbol",
    "symbolName": "play.rectangle.on.rectangle.fill"
  },
  "source": {
    "kind": "http",
    "method": "GET",
    "url": "https://www.googleapis.com/youtube/v3/search",
    "query": [
      {
        "name": "part",
        "value": "snippet"
      },
      {
        "name": "channelId",
        "value": "{{$settings.canal}}"
      },
      {
        "name": "order",
        "value": "date"
      },
      {
        "name": "maxResults",
        "value": "10"
      },
      {
        "name": "type",
        "value": "video"
      },
      {
        "name": "key",
        "value": "{{secret}}"
      }
    ],
    "format": {
      "kind": "json"
    }
  },
  "slot": {
    "label": "{{items | count}}",
    "style": "number"
  },
  "card": {
    "isEnabled": true,
    "picture": {
      "kind": "address",
      "value": "{{items[0].snippet.thumbnails.high.url}}",
      "shape": "rounded",
      "scale": 1.6
    },
    "title": "Vídeos",
    "subtitle": "Os últimos do canal",
    "emptyMessage": "Nenhum vídeo, ou a chave da API está faltando.",
    "blocks": [
      {
        "type": "list",
        "limit": 5,
        "tabs": [
          {
            "title": "Vídeos",
            "path": "items",
            "rowTitle": "{{snippet.title}}",
            "rowSubtitle": "{{snippet.publishedAt | ago}}",
            "rowImage": "{{snippet.thumbnails.medium.url}}",
            "rowWrapsTitle": true,
            "rowDetail": "{{snippet.description}}",
            "rowURL": "https://www.youtube.com/watch?v={{id.videoId}}"
          }
        ]
      }
    ]
  },
  "actions": [],
  "attention": {
    "mode": "newRows"
  },
  "settings": [
    {
      "key": "canal",
      "label": "ID do canal",
      "type": "text",
      "help": "A chave da API do YouTube Data v3 vai no campo de segredo, em Dado.",
      "required": true,
      "placeholder": "UC…"
    }
  ]
}
