{
  "schema": 2,
  "id": "plugin.exemplo.linguagens",
  "name": "Linguagens",
  "interval": 1800,
  "icon": {
    "kind": "symbol",
    "symbolName": "chevron.left.forwardslash.chevron.right"
  },
  "source": {
    "kind": "command",
    "steps": [
      {
        "program": "/usr/bin/env",
        "arguments": [
          "PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin",
          "gh",
          "api",
          "repos/{{$settings.repo}}/languages",
          "--jq",
          "([.[]] | add // 0) as $t | {total: $t, principal: (if $t > 0 then ([.[]] | max) / $t else 0 end), linguagens: (to_entries | sort_by(-.value) | map({nome: .key, bytes: .value}))}"
        ]
      }
    ],
    "format": {
      "kind": "json"
    }
  },
  "slot": {
    "label": "{{principal | percent}}",
    "value": "{{principal}}",
    "total": "1"
  },
  "card": {
    "isEnabled": true,
    "title": "{{$settings.repo}}",
    "subtitle": "Bytes de código por linguagem",
    "emptyMessage": "Esse repositório não declara linguagem nenhuma.",
    "blocks": [
      {
        "type": "bars",
        "path": "linguagens",
        "label": "{{nome}}",
        "value": "{{bytes}}",
        "limit": 6,
        "format": "bytes",
        "title": "{{linguagens[0].nome}} na frente"
      },
      {
        "type": "table",
        "title": "Todas",
        "path": "linguagens",
        "sortable": true,
        "limit": 8,
        "rowEvent": "open",
        "rowURL": "https://github.com/{{$settings.repo}}/search?l={{nome}}",
        "columns": [
          {
            "title": "Linguagem",
            "kind": "text",
            "value": "{{nome}}",
            "align": "leading"
          },
          {
            "title": "Tamanho",
            "kind": "text",
            "value": "{{bytes}}",
            "align": "trailing",
            "format": "bytes"
          }
        ]
      }
    ]
  },
  "actions": [],
  "attention": {
    "mode": "never"
  },
  "settings": [
    {
      "key": "repo",
      "label": "Repositório",
      "type": "text",
      "default": "swiftlang/swift",
      "placeholder": "dono/nome",
      "help": "Lido pelo gh, com a sua sessão. Funciona com repositório privado."
    }
  ]
}
