{
  "schema": 3,
  "id": "plugin.exemplo.servidores",
  "name": "Servidores",
  "interval": 300,
  "readsOnItsOwn": false,
  "icon": {
    "kind": "symbol",
    "symbolName": "server.rack"
  },
  "source": {
    "kind": "panel",
    "format": {
      "kind": "json"
    }
  },
  "slot": {
    "label": "",
    "style": "arc"
  },
  "card": {
    "isEnabled": true,
    "title": "Servidores",
    "subtitle": "Abrir um terminal em cada um",
    "blocks": [
      {
        "type": "buttons",
        "resultSpot": "below"
      }
    ]
  },
  "actions": [
    {
      "name": "Produção",
      "symbolName": "externaldrive.connected.to.line.below.fill",
      "place": "panel",
      "size": "small",
      "titleSpot": "below",
      "hue": "red",
      "run": {
        "kind": "onTheMac",
        "errand": "openLink",
        "text": "ssh://{{$settings.producao}}"
      },
      "successReport": "nothing"
    },
    {
      "name": "Homologação",
      "symbolName": "externaldrive.fill",
      "place": "panel",
      "size": "small",
      "titleSpot": "below",
      "hue": "orange",
      "run": {
        "kind": "onTheMac",
        "errand": "openLink",
        "text": "ssh://{{$settings.homologacao}}"
      },
      "successReport": "nothing"
    },
    {
      "name": "Banco",
      "symbolName": "cylinder.split.1x2.fill",
      "place": "panel",
      "size": "small",
      "titleSpot": "below",
      "hue": "indigo",
      "run": {
        "kind": "onTheMac",
        "errand": "openLink",
        "text": "ssh://{{$settings.banco}}"
      },
      "successReport": "nothing"
    },
    {
      "name": "Copiar o comando de produção",
      "symbolName": "doc.on.doc",
      "place": "panel",
      "size": "large",
      "titleSpot": "inside",
      "hue": "theme",
      "run": {
        "kind": "onTheMac",
        "errand": "copy",
        "text": "ssh {{$settings.producao}}"
      },
      "successMessage": "Comando copiado."
    }
  ],
  "attention": {
    "mode": "never"
  },
  "settings": [
    {
      "key": "producao",
      "label": "Produção",
      "type": "text",
      "placeholder": "deploy@1.2.3.4"
    },
    {
      "key": "homologacao",
      "label": "Homologação",
      "type": "text",
      "placeholder": "deploy@5.6.7.8"
    },
    {
      "key": "banco",
      "label": "Banco",
      "type": "text",
      "placeholder": "dba@9.10.11.12"
    }
  ]
}
