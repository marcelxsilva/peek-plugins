{
  "schema": 3,
  "id": "plugin.exemplo.lancamentos",
  "name": "Lançamentos",
  "interval": 21600,
  "icon": {
    "kind": "picture",
    "symbolName": "paperplane.circle.fill",
    "pictureSource": "https://raw.githubusercontent.com/marcelxsilva/peek-plugins/main/assets/icons/lancamentos.png"
  },
  "source": {
    "kind": "http",
    "method": "GET",
    "url": "https://ll.thespacedevs.com/2.2.0/launch/upcoming/",
    "query": [
      {
        "name": "limit",
        "value": "10"
      },
      {
        "name": "mode",
        "value": "list"
      }
    ],
    "format": {
      "kind": "json"
    }
  },
  "slot": {
    "label": "{{count}}",
    "style": "number"
  },
  "card": {
    "isEnabled": true,
    "title": "Lançamentos",
    "subtitle": "Os próximos foguetes a subir",
    "emptyMessage": "Nenhum lançamento agendado.",
    "components": [
      {
        "type": "timeline",
        "path": "results",
        "date": "{{net}}",
        "rowTitle": "{{name}}",
        "rowSubtitle": "{{lsp_name}} · {{location}}",
        "range": "upcoming",
        "limit": 8
      }
    ]
  },
  "actions": [
    {
      "name": "Ver a agenda",
      "symbolName": "arrow.up.forward.square",
      "place": "card",
      "isProminent": false,
      "run": {
        "kind": "onTheMac",
        "errand": "openLink",
        "text": "https://nextspaceflight.com/launches/"
      },
      "successReport": "nothing"
    }
  ],
  "attention": {
    "mode": "newRows"
  }
}
