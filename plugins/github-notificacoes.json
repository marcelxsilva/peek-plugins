{
  "schema": 11,
  "id": "plugin.exemplo.github-notificacoes",
  "name": "Notificações do GitHub",
  "interval": 300,
  "icon": {
    "kind": "symbol",
    "symbolName": "bell.badge.fill"
  },
  "source": {
    "kind": "http",
    "method": "GET",
    "url": "https://api.github.com/notifications",
    "headers": [
      {
        "name": "Authorization",
        "value": "Bearer {{secret}}"
      },
      {
        "name": "Accept",
        "value": "application/vnd.github+json"
      }
    ],
    "format": {
      "kind": "json"
    }
  },
  "slot": {
    "label": "{{$ | count}}",
    "style": "number"
  },
  "card": {
    "isEnabled": true,
    "title": "Notificações",
    "subtitle": "O que está esperando você no GitHub",
    "emptyMessage": "Caixa limpa.",
    "blocks": [
      {
        "type": "hero",
        "value": "{{$ | count}}",
        "caption": "Não lidas",
        "format": "integer",
        "goodDirection": "down",
        "width": "half"
      },
      {
        "type": "breakdown",
        "title": "Motivo",
        "breakdownStyle": "list",
        "path": "$",
        "groupField": "{{reason}}",
        "groupKind": "text",
        "measure": "count",
        "shows": "amount",
        "groups": [
          {
            "id": "DD6E276A-ACB3-45E5-BF30-063C4FC10191",
            "name": "Revisão",
            "color": "yellow",
            "match": "review_requested"
          },
          {
            "id": "4F2E4EC7-50BB-4762-975D-0683E642AE44",
            "name": "Menção",
            "color": "orange",
            "match": "mention, team_mention"
          },
          {
            "id": "3E2505D0-0D98-47F6-8C58-B52319BA9615",
            "name": "Atribuído",
            "color": "blue",
            "match": "assign"
          },
          {
            "id": "79193590-8DA4-4253-9621-AB72A554AF94",
            "name": "Comentário",
            "color": "purple",
            "match": "comment"
          }
        ],
        "others": {
          "shows": true,
          "name": "Outros",
          "color": "gray"
        },
        "width": "half"
      },
      {
        "type": "list",
        "limit": 6,
        "tabs": [
          {
            "title": "Não lidas",
            "path": "$",
            "rowTitle": "{{subject.title}}",
            "rowSubtitle": "{{repository.full_name}}",
            "rowMeta": "{{updated_at | ago}}",
            "rowWrapsTitle": true,
            "rowBadge": "{{subject.type}}",
            "rowImage": "{{repository.owner.avatar_url}}",
            "rowImageShape": "round",
            "rowStatus": "{{reason}}",
            "statusWords": {
              "assign": "atribuído",
              "author": "seu",
              "comment": "comentário",
              "mention": "menção",
              "review_requested": "revisão",
              "subscribed": "inscrito",
              "team_mention": "time",
              "state_change": "mudou"
            },
            "statusColors": {
              "review_requested": "attention",
              "mention": "attention",
              "assign": "attention",
              "author": "positive"
            },
            "rowURL": "{{repository.html_url}}"
          }
        ]
      }
    ]
  },
  "actions": [
    {
      "name": "Abrir no GitHub",
      "symbolName": "arrow.up.forward.square",
      "place": "card",
      "run": {
        "kind": "onTheMac",
        "errand": "openLink",
        "text": "https://github.com/notifications"
      },
      "successReport": "nothing"
    }
  ],
  "attention": {
    "mode": "newRows"
  }
}
