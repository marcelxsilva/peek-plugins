{
  "schema": 6,
  "id": "plugin.exemplo.xkcd",
  "name": "xkcd",
  "interval": 21600,
  "icon": {
    "kind": "symbol",
    "symbolName": "face.smiling"
  },
  "source": {
    "kind": "http",
    "method": "GET",
    "url": "https://xkcd.com/info.0.json",
    "format": {
      "kind": "json"
    }
  },
  "slot": {
    "label": "{{num}}",
    "style": "number"
  },
  "card": {
    "isEnabled": true,
    "picture": {
      "kind": "address",
      "value": "{{img}}",
      "shape": "rounded",
      "scale": 2.4
    },
    "title": "{{safe_title}}",
    "subtitle": "xkcd {{num}} · {{day}}/{{month}}/{{year}}",
    "emptyMessage": "O xkcd não respondeu.",
    "blocks": [
      {
        "type": "text",
        "value": "{{alt}}",
        "maxHeight": "small"
      }
    ]
  },
  "actions": [
    {
      "name": "Abrir a tirinha",
      "symbolName": "arrow.up.forward.square",
      "place": "card",
      "isProminent": false,
      "run": {
        "kind": "onTheMac",
        "errand": "openLink",
        "text": "https://xkcd.com/{{num}}/"
      },
      "successReport": "nothing"
    },
    {
      "name": "Ler depois",
      "symbolName": "bookmark",
      "place": "card",
      "run": {
        "kind": "onTheMac",
        "errand": "readLater",
        "text": "https://xkcd.com/{{num}}/"
      },
      "successMessage": "Guardado."
    }
  ],
  "attention": {
    "mode": "newRows"
  }
}
