{
  "schema": 2,
  "id": "plugin.exemplo.uv",
  "name": "Índice UV",
  "interval": 1800,
  "icon": {
    "kind": "picture",
    "symbolName": "sun.max.trianglebadge.exclamationmark.fill",
    "pictureSource": "https://raw.githubusercontent.com/marcelxsilva/peek-plugins/main/assets/icons/uv.png"
  },
  "source": {
    "kind": "http",
    "method": "GET",
    "url": "https://api.open-meteo.com/v1/forecast?latitude={{$settings.lat}}&longitude={{$settings.lon}}&current=uv_index&hourly=uv_index&forecast_days=1&timezone=auto",
    "format": {
      "kind": "json"
    }
  },
  "slot": {
    "label": "{{current.uv_index | round}}",
    "value": "{{current.uv_index}}",
    "total": "11",
    "style": "arc",
    "alertsOnThreshold": true
  },
  "card": {
    "isEnabled": true,
    "title": "Índice UV",
    "subtitle": "{{timezone}}",
    "blocks": [
      {
        "type": "hero",
        "value": "{{current.uv_index}}",
        "total": "11",
        "caption": "Agora · 0 a 2 é baixo, 8 ou mais é muito alto",
        "goodDirection": "down",
        "format": "number"
      },
      {
        "type": "chart",
        "style": "area",
        "title": "Ao longo do dia",
        "path": "hourly.uv_index",
        "x": "hourly.time",
        "dateFormat": "yyyy-MM-dd'T'HH:mm",
        "height": "medium",
        "format": "number"
      },
      {
        "type": "text",
        "value": "Acima de 6 o protetor solar deixa de ser opcional; acima de 8, sombra e chapéu também.",
        "maxHeight": "small"
      }
    ]
  },
  "actions": [],
  "attention": {
    "mode": "countAbove",
    "comparison": "above",
    "countPath": "current.uv_index",
    "threshold": 8
  },
  "settings": [
    {
      "key": "lat",
      "label": "Latitude",
      "type": "text",
      "default": "-23.55"
    },
    {
      "key": "lon",
      "label": "Longitude",
      "type": "text",
      "default": "-46.63"
    }
  ]
}
