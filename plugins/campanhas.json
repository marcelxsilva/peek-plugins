{
  "schema": 7,
  "id": "plugin.exemplo.campanhas",
  "name": "Campanhas",
  "interval": 3600,
  "readsOnItsOwn": false,
  "icon": {
    "kind": "symbol",
    "symbolName": "megaphone.fill"
  },
  "source": {
    "kind": "panel",
    "format": {
      "kind": "json"
    }
  },
  "answer": "{\n  \"mes\": \"Setembro de 2026\",\n  \"investido\": 42000,\n  \"retorno\": 138600,\n  \"canais\": [\n    {\n      \"nome\": \"Google Ads\",\n      \"investido\": 18000,\n      \"leads\": 214\n    },\n    {\n      \"nome\": \"Meta Ads\",\n      \"investido\": 12500,\n      \"leads\": 168\n    },\n    {\n      \"nome\": \"LinkedIn\",\n      \"investido\": 7500,\n      \"leads\": 46\n    },\n    {\n      \"nome\": \"Newsletter\",\n      \"investido\": 4000,\n      \"leads\": 92\n    }\n  ]\n}",
  "slot": {
    "label": "{{investido | shape #,##0}}",
    "style": "arc"
  },
  "card": {
    "isEnabled": true,
    "title": "Campanhas",
    "subtitle": "{{mes}}",
    "blocks": [
      {
        "type": "hero",
        "value": "{{retorno}}",
        "previous": "{{investido}}",
        "caption": "Retorno sobre {{investido | shape R$ #,##0}} investidos",
        "goodDirection": "up",
        "format": "money",
        "currency": "BRL"
      },
      {
        "type": "bars",
        "path": "canais",
        "label": "{{nome}}",
        "value": "{{leads}}",
        "limit": 6,
        "format": "integer",
        "title": "Leads por canal"
      },
      {
        "type": "table",
        "path": "canais",
        "sortable": true,
        "limit": 6,
        "rowEvent": "none",
        "columns": [
          {
            "title": "Canal",
            "kind": "text",
            "value": "{{nome}}",
            "align": "leading"
          },
          {
            "title": "Investido",
            "kind": "text",
            "value": "{{investido}}",
            "align": "trailing",
            "format": "money",
            "currency": "BRL"
          },
          {
            "title": "Leads",
            "kind": "text",
            "value": "{{leads}}",
            "align": "trailing",
            "format": "integer"
          }
        ]
      }
    ]
  },
  "actions": [],
  "attention": {
    "mode": "never"
  }
}
