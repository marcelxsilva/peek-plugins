{
  "schema": 7,
  "id": "plugin.exemplo.capacidade",
  "name": "Capacidade do time",
  "interval": 3600,
  "readsOnItsOwn": false,
  "icon": {
    "kind": "symbol",
    "symbolName": "person.3.fill"
  },
  "source": {
    "kind": "panel",
    "format": {
      "kind": "json"
    }
  },
  "answer": "{\n  \"sprint\": \"Sprint 42\",\n  \"pontos_planejados\": 48,\n  \"pontos_entregues\": 31,\n  \"pessoas\": [\n    {\n      \"nome\": \"Ana\",\n      \"pontos\": 12\n    },\n    {\n      \"nome\": \"Bruno\",\n      \"pontos\": 11\n    },\n    {\n      \"nome\": \"Carla\",\n      \"pontos\": 8\n    }\n  ]\n}",
  "slot": {
    "label": "{{pontos_entregues}}",
    "value": "{{pontos_entregues}}",
    "total": "{{pontos_planejados}}",
    "style": "arc"
  },
  "card": {
    "isEnabled": true,
    "title": "Capacidade do time",
    "subtitle": "{{sprint}}",
    "blocks": [
      {
        "type": "hero",
        "value": "{{pontos_entregues}}",
        "total": "{{pontos_planejados}}",
        "caption": "Pontos entregues contra o planejado",
        "goodDirection": "up",
        "format": "integer"
      },
      {
        "type": "bars",
        "path": "pessoas",
        "label": "{{nome}}",
        "value": "{{pontos}}",
        "limit": 6,
        "format": "integer",
        "title": "Por pessoa"
      },
      {
        "type": "text",
        "value": "Atualize os números na aba **Dado** ao fim de cada sprint.",
        "maxHeight": "small"
      }
    ]
  },
  "actions": [],
  "attention": {
    "mode": "never"
  }
}
