{
  "schema": 7,
  "id": "plugin.exemplo.contas",
  "name": "Contas a pagar",
  "interval": 3600,
  "readsOnItsOwn": false,
  "icon": {
    "kind": "symbol",
    "symbolName": "banknote.fill"
  },
  "source": {
    "kind": "panel",
    "format": {
      "kind": "json"
    }
  },
  "answer": "{\n  \"contas\": [\n    { \"nome\": \"Aluguel\", \"vence\": \"2026-10-05\", \"valor\": 4200, \"quem\": \"Imobiliária\" },\n    { \"nome\": \"Internet\", \"vence\": \"2026-10-10\", \"valor\": 149.9, \"quem\": \"Provedor\" },\n    { \"nome\": \"Contador\", \"vence\": \"2026-10-15\", \"valor\": 890, \"quem\": \"Escritório\" },\n    { \"nome\": \"Cartão\", \"vence\": \"2026-10-20\", \"valor\": 3120.45, \"quem\": \"Banco\" }\n  ]\n}",
  "slot": {
    "label": "{{contas | count}}",
    "style": "number"
  },
  "card": {
    "isEnabled": true,
    "title": "Contas a pagar",
    "subtitle": "O que vence e quando",
    "emptyMessage": "Nenhuma conta escrita ainda.",
    "blocks": [
      {
        "type": "hero",
        "value": "{{contas[0].valor}}",
        "caption": "Próxima: {{contas[0].nome}}, vence {{contas[0].vence | date}}",
        "format": "money",
        "currency": "BRL",
        "goodDirection": "down"
      },
      {
        "type": "timeline",
        "path": "contas",
        "date": "{{vence}}",
        "rowTitle": "{{nome}}",
        "rowSubtitle": "{{quem}}",
        "range": "upcoming",
        "limit": 8
      },
      {
        "type": "table",
        "path": "contas",
        "sortable": true,
        "limit": 6,
        "rowEvent": "none",
        "columns": [
          {
            "title": "Conta",
            "kind": "text",
            "value": "{{nome}}",
            "align": "leading"
          },
          {
            "title": "Vence",
            "kind": "text",
            "value": "{{vence | shape dd/MM}}",
            "align": "leading"
          },
          {
            "title": "Valor",
            "kind": "text",
            "value": "{{valor}}",
            "align": "trailing",
            "format": "money",
            "currency": "BRL"
          }
        ]
      }
    ]
  },
  "actions": [],
  "attention": {
    "mode": "never"
  }
}
