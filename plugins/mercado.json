{
  "schema": 7,
  "id": "plugin.exemplo.mercado",
  "name": "Compras",
  "interval": 3600,
  "readsOnItsOwn": false,
  "icon": {
    "kind": "symbol",
    "symbolName": "cart.fill"
  },
  "source": {
    "kind": "panel",
    "format": {
      "kind": "json"
    }
  },
  "answer": "{\n  \"itens\": [\n    {\n      \"nome\": \"Café\",\n      \"quanto\": \"2 pacotes\",\n      \"onde\": \"Mercado\"\n    },\n    {\n      \"nome\": \"Azeite\",\n      \"quanto\": \"1 lata\",\n      \"onde\": \"Mercado\"\n    },\n    {\n      \"nome\": \"Pilhas AA\",\n      \"quanto\": \"4\",\n      \"onde\": \"Papelaria\"\n    },\n    {\n      \"nome\": \"Ração\",\n      \"quanto\": \"10 kg\",\n      \"onde\": \"Pet shop\"\n    }\n  ]\n}",
  "slot": {
    "label": "{{itens | count}}",
    "style": "number"
  },
  "card": {
    "isEnabled": true,
    "title": "Compras",
    "subtitle": "A lista fica no próprio arquivo",
    "emptyMessage": "Lista vazia.",
    "blocks": [
      {
        "type": "list",
        "limit": 8,
        "tabs": [
          {
            "title": "Itens",
            "path": "itens",
            "rowTitle": "{{nome}}",
            "rowSubtitle": "{{quanto}}",
            "rowMeta": "{{onde}}",
            "sections": "{{onde}}",
            "rowEvent": "none"
          }
        ]
      },
      {
        "type": "buttons",
        "resultSpot": "below"
      }
    ]
  },
  "actions": [
    {
      "name": "Copiar a lista",
      "symbolName": "doc.on.doc",
      "place": "panel",
      "size": "large",
      "titleSpot": "inside",
      "hue": "green",
      "run": {
        "kind": "onTheMac",
        "errand": "copy",
        "text": "{{itens[*].nome}}"
      },
      "successMessage": "Lista copiada."
    },
    {
      "name": "Anotar o que está copiado",
      "symbolName": "plus.circle.fill",
      "place": "panel",
      "size": "large",
      "titleSpot": "inside",
      "hue": "teal",
      "run": {
        "kind": "onTheMac",
        "errand": "remember",
        "variable": "compras_extra",
        "text": "{{$clipboard}}"
      },
      "successMessage": "Anotado em compras_extra."
    }
  ],
  "attention": {
    "mode": "never"
  }
}
