{
  "schema": 8,
  "id": "plugin.exemplo.pypi",
  "name": "PyPI",
  "interval": 3600,
  "icon": {
    "kind": "word",
    "word": "{{info.version}}"
  },
  "source": {
    "kind": "http",
    "method": "GET",
    "url": "https://pypi.org/pypi/{{$settings.pacote}}/json",
    "format": {
      "kind": "json"
    }
  },
  "slot": {
    "label": "{{info.name}}",
    "style": "arc"
  },
  "card": {
    "isEnabled": true,
    "title": "{{info.name}} {{info.version}}",
    "subtitle": "Publicado {{urls[0].upload_time_iso_8601 | ago}}",
    "blocks": [
      {
        "type": "text",
        "value": "{{info.summary}}",
        "maxHeight": "small"
      },
      {
        "type": "properties",
        "layout": "columns",
        "properties": [
          {
            "id": "3C37E369-A53F-4D67-B3BF-D282FAF1853B",
            "name": "Python",
            "value": "{{info.requires_python}}"
          },
          {
            "id": "3C9DF98E-B51A-4ED4-892A-5997798D453F",
            "name": "Licença",
            "value": "{{info.license}}"
          }
        ]
      },
      {
        "type": "table",
        "title": "Arquivos da última versão",
        "path": "urls",
        "sortable": true,
        "limit": 6,
        "rowEvent": "none",
        "columns": [
          {
            "title": "Arquivo",
            "kind": "text",
            "value": "{{filename}}",
            "align": "leading"
          },
          {
            "title": "Tipo",
            "kind": "text",
            "value": "{{packagetype}}",
            "align": "leading"
          },
          {
            "title": "Tamanho",
            "kind": "text",
            "value": "{{size}}",
            "align": "trailing",
            "format": "bytes"
          }
        ]
      }
    ]
  },
  "actions": [
    {
      "name": "Abrir no PyPI",
      "symbolName": "arrow.up.forward.square",
      "place": "card",
      "run": {
        "kind": "onTheMac",
        "errand": "openLink",
        "text": "https://pypi.org/project/{{info.name}}/"
      },
      "successReport": "nothing"
    },
    {
      "name": "Copiar o pip install",
      "symbolName": "doc.on.doc",
      "place": "card",
      "run": {
        "kind": "onTheMac",
        "errand": "copy",
        "text": "pip install {{info.name}}=={{info.version}}"
      },
      "successMessage": "Comando copiado."
    }
  ],
  "attention": {
    "mode": "never"
  },
  "settings": [
    {
      "key": "pacote",
      "label": "Pacote",
      "type": "text",
      "default": "requests",
      "required": true
    }
  ]
}
