{
  "schema": 5,
  "id": "plugin.exemplo.dns",
  "name": "DNS",
  "interval": 900,
  "icon": {
    "kind": "symbol",
    "symbolName": "point.3.filled.connected.trianglepath.dotted"
  },
  "source": {
    "kind": "http",
    "method": "GET",
    "url": "https://dns.google/resolve",
    "query": [
      {
        "name": "name",
        "value": "{{$settings.dominio}}"
      },
      {
        "name": "type",
        "value": "{{$settings.tipo}}"
      }
    ],
    "format": {
      "kind": "json"
    }
  },
  "slot": {
    "label": "{{Answer | count}}",
    "style": "number"
  },
  "card": {
    "isEnabled": true,
    "title": "{{$settings.dominio}}",
    "subtitle": "Registros {{$settings.tipo}}",
    "emptyMessage": "Nenhum registro deste tipo.",
    "blocks": [
      {
        "type": "list",
        "limit": 8,
        "tabs": [
          {
            "title": "Respostas",
            "path": "Answer",
            "rowTitle": "{{data}}",
            "rowSubtitle": "{{name}}",
            "rowMeta": "TTL {{TTL}} s",
            "rowEvent": "none",
            "rowWrapsTitle": true
          }
        ]
      }
    ]
  },
  "actions": [
    {
      "name": "Copiar o primeiro",
      "symbolName": "doc.on.doc",
      "place": "card",
      "run": {
        "kind": "onTheMac",
        "errand": "copy",
        "text": "{{Answer[0].data}}"
      },
      "successMessage": "{{Answer[0].data}} copiado."
    }
  ],
  "attention": {
    "mode": "newRows"
  },
  "settings": [
    {
      "key": "dominio",
      "label": "Domínio",
      "type": "text",
      "default": "github.com",
      "required": true
    },
    {
      "key": "tipo",
      "label": "Tipo",
      "type": "choice",
      "default": "A",
      "options": [
        {
          "value": "A",
          "label": "A"
        },
        {
          "value": "AAAA",
          "label": "AAAA"
        },
        {
          "value": "CNAME",
          "label": "CNAME"
        },
        {
          "value": "MX",
          "label": "MX"
        },
        {
          "value": "TXT",
          "label": "TXT"
        },
        {
          "value": "NS",
          "label": "NS"
        }
      ]
    }
  ]
}
