{
  "schema": 6,
  "id": "plugin.exemplo.noticias-br",
  "name": "Notícias do IBGE",
  "interval": 3600,
  "icon": {
    "kind": "picture",
    "symbolName": "newspaper.fill",
    "pictureSource": "https://www.google.com/s2/favicons?domain=ibge.gov.br&sz=128"
  },
  "source": {
    "kind": "http",
    "method": "GET",
    "url": "https://servicodados.ibge.gov.br/api/v3/noticias/",
    "query": [
      {
        "name": "qtd",
        "value": "12"
      },
      {
        "name": "page",
        "value": "{{$page}}"
      }
    ],
    "format": {
      "kind": "json"
    },
    "pagination": {
      "kind": "page",
      "listPath": "items",
      "start": 1,
      "maxPages": 5,
      "buttonText": "Mais notícias"
    }
  },
  "slot": {
    "label": "{{items | count}}",
    "style": "number"
  },
  "card": {
    "isEnabled": true,
    "title": "Notícias do IBGE",
    "subtitle": "Releases e matérias oficiais",
    "emptyMessage": "Nada publicado agora.",
    "blocks": [
      {
        "type": "list",
        "limit": 6,
        "tabs": [
          {
            "title": "Notícias",
            "path": "items",
            "rowTitle": "{{titulo}}",
            "rowSubtitle": "{{introducao}}",
            "rowMeta": "{{data_publicacao | ago}}",
            "rowBadge": "{{tipo}}",
            "rowWrapsTitle": true,
            "rowURL": "{{link}}"
          }
        ]
      }
    ]
  },
  "actions": [
    {
      "name": "Ler depois",
      "symbolName": "bookmark",
      "place": "row",
      "listIndex": 0,
      "run": {
        "kind": "onTheMac",
        "errand": "readLater",
        "text": "{{link}}"
      },
      "successMessage": "Guardado."
    }
  ],
  "attention": {
    "mode": "newRows"
  }
}
