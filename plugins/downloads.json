{
  "schema": 11,
  "id": "plugin.exemplo.downloads",
  "name": "Downloads",
  "interval": 300,
  "icon": {
    "kind": "symbol",
    "symbolName": "arrow.down.circle.fill"
  },
  "source": {
    "kind": "command",
    "steps": [
      {
        "program": "/usr/bin/find",
        "arguments": [
          "{{$settings.pasta}}",
          "-maxdepth",
          "1",
          "-type",
          "f",
          "-mtime",
          "-7"
        ]
      }
    ],
    "format": {
      "kind": "files"
    }
  },
  "slot": {
    "label": "{{files | count}}",
    "style": "number"
  },
  "card": {
    "isEnabled": true,
    "title": "Downloads",
    "subtitle": "Baixados nos últimos 7 dias",
    "emptyMessage": "Nada novo na pasta.",
    "blocks": [
      {
        "type": "hero",
        "value": "{{files | count}}",
        "caption": "Arquivos da última semana",
        "goodDirection": "up",
        "format": "integer",
        "width": "half"
      },
      {
        "type": "breakdown",
        "title": "Por tipo",
        "breakdownStyle": "list",
        "path": "files",
        "groupField": "{{ext}}",
        "groupKind": "text",
        "measure": "count",
        "shows": "amount",
        "groups": [
          {
            "id": "BE5D9F44-5F2F-4CC6-9E64-6117C5B7452F",
            "name": "Documentos",
            "color": "blue",
            "match": "pdf, doc, docx, pages, txt, rtf, md, csv, xls, xlsx, numbers, ppt, pptx, key"
          },
          {
            "id": "F9B4955A-9D35-44DF-A2EB-9B7342BD81B9",
            "name": "Imagens",
            "color": "purple",
            "match": "png, jpg, jpeg, heic, gif, webp, svg"
          },
          {
            "id": "D2170984-5BDE-45BD-B61A-CB1578178033",
            "name": "Pacotes",
            "color": "orange",
            "match": "dmg, pkg, zip, tar, gz, tgz, 7z, rar"
          },
          {
            "id": "0DCA0EC0-77E9-40AA-9675-03445FBC4E77",
            "name": "Vídeo e áudio",
            "color": "pink",
            "match": "mp4, mov, m4v, mkv, mp3, m4a, wav"
          }
        ],
        "others": {
          "shows": true,
          "name": "Outros",
          "color": "gray"
        },
        "width": "half"
      },
      {
        "type": "list",
        "limit": 6,
        "tabs": [
          {
            "title": "Arquivos",
            "path": "files[*]",
            "rowTitle": "{{name}}",
            "rowSubtitle": "{{size | bytes}} · {{ext | upper}}",
            "rowMeta": "{{modified | ago}}",
            "rowWrapsTitle": true,
            "rowURL": "{{path}}"
          }
        ]
      }
    ]
  },
  "actions": [
    {
      "name": "Mostrar no Finder",
      "symbolName": "folder",
      "place": "row",
      "listIndex": 0,
      "run": {
        "kind": "command",
        "steps": [
          {
            "program": "/usr/bin/open",
            "arguments": [
              "-R",
              "{{path}}"
            ]
          }
        ]
      },
      "successReport": "nothing"
    },
    {
      "name": "Copiar o caminho",
      "symbolName": "doc.on.doc",
      "place": "row",
      "listIndex": 0,
      "run": {
        "kind": "onTheMac",
        "errand": "copy",
        "text": "{{path}}"
      },
      "successMessage": "Caminho copiado."
    }
  ],
  "attention": {
    "mode": "newRows"
  },
  "settings": [
    {
      "key": "pasta",
      "label": "Pasta",
      "type": "text",
      "help": "Caminho absoluto. Aqui não há shell, então nada de ~ nem $HOME.",
      "required": true,
      "placeholder": "/Users/voce/Downloads"
    }
  ],
  "answer": "/Users/voce/Downloads/Relatório trimestral Q3.pdf\n/Users/voce/Downloads/Captura de Tela 2026-09-30 às 15.42.11.png\n/Users/voce/Downloads/Docker.dmg\n/Users/voce/Downloads/planilha-orcamento-2026.xlsx\n/Users/voce/Downloads/fotos-evento.zip\n/Users/voce/Downloads/reuniao-gravada.mp4\n"
}
