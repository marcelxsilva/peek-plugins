{
  "schema": 8,
  "id": "plugin.exemplo.mastodon",
  "name": "Mastodon",
  "interval": 1800,
  "icon": {
    "kind": "picture",
    "symbolName": "m.circle.fill",
    "pictureSource": "https://github.com/mastodon.png?size=128"
  },
  "source": {
    "kind": "http",
    "method": "GET",
    "url": "https://{{$settings.instancia}}/api/v1/accounts/lookup",
    "query": [
      {
        "name": "acct",
        "value": "{{$settings.conta}}"
      }
    ],
    "format": {
      "kind": "json"
    }
  },
  "slot": {
    "label": "{{followers_count}}",
    "style": "sparkline"
  },
  "history": {
    "path": "followers_count",
    "keep": 192
  },
  "card": {
    "isEnabled": true,
    "picture": {
      "kind": "address",
      "value": "{{avatar}}",
      "shape": "round"
    },
    "title": "{{display_name ?? username}}",
    "subtitle": "@{{acct}}@{{$settings.instancia}}",
    "emptyMessage": "Conta não encontrada nessa instância.",
    "blocks": [
      {
        "type": "hero",
        "value": "{{followers_count}}",
        "caption": "Seguidores",
        "goodDirection": "up",
        "format": "integer",
        "width": "half"
      },
      {
        "type": "properties",
        "width": "half",
        "layout": "stacked",
        "properties": [
          {
            "id": "836E56B1-EDD5-4753-BC8F-320DBC240AFE",
            "name": "Segue",
            "value": "{{following_count}}"
          },
          {
            "id": "18F8B817-FD32-48D5-BACD-2071BCBB2C7F",
            "name": "Posts",
            "value": "{{statuses_count}}"
          }
        ]
      },
      {
        "type": "chart",
        "style": "area",
        "title": "Seguidores ao longo do tempo",
        "height": "medium",
        "format": "integer"
      }
    ]
  },
  "actions": [
    {
      "name": "Abrir o perfil",
      "symbolName": "arrow.up.forward.square",
      "place": "card",
      "isProminent": false,
      "run": {
        "kind": "onTheMac",
        "errand": "openLink",
        "text": "{{url}}"
      },
      "successReport": "nothing"
    }
  ],
  "attention": {
    "mode": "never"
  },
  "settings": [
    {
      "key": "instancia",
      "label": "Instância",
      "type": "text",
      "default": "mastodon.social",
      "required": true
    },
    {
      "key": "conta",
      "label": "Conta",
      "type": "text",
      "default": "Gargron",
      "required": true
    }
  ]
}
