{
  "schema": 8,
  "id": "plugin.exemplo.clima",
  "name": "Clima",
  "interval": 1800,
  "icon": {
    "kind": "picture",
    "symbolName": "cloud.sun.fill",
    "pictureSource": "https://raw.githubusercontent.com/marcelxsilva/peek-plugins/main/assets/icons/clima.png"
  },
  "source": {
    "kind": "http",
    "method": "GET",
    "url": "https://api.open-meteo.com/v1/forecast?latitude={{$settings.lat}}&longitude={{$settings.lon}}&current=temperature_2m,apparent_temperature,relative_humidity_2m,wind_speed_10m&hourly=temperature_2m&daily=temperature_2m_max,temperature_2m_min,sunrise,sunset&forecast_days=2&forecast_hours=48&timezone=auto",
    "format": {
      "kind": "json"
    }
  },
  "slot": {
    "label": "{{current.temperature_2m | round}}°",
    "value": "{{current.relative_humidity_2m}}",
    "total": "100",
    "style": "arc"
  },
  "history": {
    "path": "current.temperature_2m",
    "keep": 48
  },
  "card": {
    "isEnabled": true,
    "title": "Clima",
    "subtitle": "{{timezone}}",
    "blocks": [
      {
        "type": "hero",
        "value": "{{current.temperature_2m}}",
        "caption": "Sensação de {{current.apparent_temperature | round}}° · Vento {{current.wind_speed_10m | round}} km/h",
        "format": "number"
      },
      {
        "type": "chart",
        "title": "Próximas 48 horas",
        "style": "area",
        "path": "hourly.temperature_2m",
        "x": "hourly.time",
        "height": "medium",
        "format": "number",
        "dateFormat": "yyyy-MM-dd'T'HH:mm"
      },
      {
        "type": "properties",
        "title": "Máxima e mínima",
        "layout": "grid",
        "properties": [
          {
            "id": "81EEBD77-EC7A-459E-A92D-E016882D17A7",
            "name": "Hoje",
            "value": "{{daily.temperature_2m_max[0] | round}}° / {{daily.temperature_2m_min[0] | round}}°"
          },
          {
            "id": "DE64EDDD-3785-4ED9-99EA-BE2CB33040E3",
            "name": "Amanhã",
            "value": "{{daily.temperature_2m_max[1] | round}}° / {{daily.temperature_2m_min[1] | round}}°"
          },
          {
            "id": "84BA08B6-36FF-409D-8BB1-0E07A31DAA78",
            "name": "Nascer do sol",
            "value": "{{daily.sunrise[0] | shape HH:mm}}"
          },
          {
            "id": "84C2E8F9-D8B1-4734-B211-B5CE827ECC93",
            "name": "Pôr do sol",
            "value": "{{daily.sunset[0] | shape HH:mm}}"
          }
        ]
      }
    ]
  },
  "actions": [],
  "attention": {
    "mode": "countAbove",
    "comparison": "above",
    "countPath": "current.temperature_2m",
    "threshold": "{{$settings.avisar}}"
  },
  "settings": [
    {
      "key": "lat",
      "label": "Latitude",
      "type": "text",
      "default": "-23.55",
      "help": "Coordenada do lugar. São Paulo vem preenchida."
    },
    {
      "key": "lon",
      "label": "Longitude",
      "type": "text",
      "default": "-46.63"
    },
    {
      "key": "avisar",
      "label": "Avisar acima de",
      "type": "number",
      "default": 35,
      "help": "Em graus Celsius. O ícone pisca quando a temperatura cruza esse valor."
    }
  ]
}
