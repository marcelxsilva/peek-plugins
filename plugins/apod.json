{
  "schema": 6,
  "id": "plugin.exemplo.apod",
  "name": "Foto do dia da NASA",
  "interval": 21600,
  "icon": {
    "kind": "symbol",
    "symbolName": "sparkles"
  },
  "source": {
    "kind": "http",
    "method": "GET",
    "url": "https://api.nasa.gov/planetary/apod",
    "query": [
      {
        "name": "api_key",
        "value": "{{$settings.chave}}"
      }
    ],
    "format": {
      "kind": "json"
    }
  },
  "slot": {
    "label": "NASA",
    "style": "arc"
  },
  "card": {
    "isEnabled": true,
    "picture": {
      "kind": "address",
      "value": "{{url}}",
      "shape": "rounded",
      "scale": 2.2
    },
    "title": "{{title}}",
    "subtitle": "{{date | date}} · {{copyright ?? \"NASA\"}}",
    "blocks": [
      {
        "type": "text",
        "value": "{{explanation}}",
        "maxHeight": "medium"
      }
    ]
  },
  "actions": [
    {
      "name": "Ver em tamanho cheio",
      "symbolName": "arrow.up.left.and.arrow.down.right",
      "place": "card",
      "isProminent": true,
      "run": {
        "kind": "onTheMac",
        "errand": "openLink",
        "text": "{{hdurl ?? url}}"
      },
      "successReport": "nothing"
    },
    {
      "name": "Guardar para ler depois",
      "symbolName": "bookmark",
      "place": "card",
      "run": {
        "kind": "onTheMac",
        "errand": "readLater",
        "text": "https://apod.nasa.gov/apod/astropix.html"
      },
      "successMessage": "Guardado."
    }
  ],
  "attention": {
    "mode": "never"
  },
  "settings": [
    {
      "key": "chave",
      "label": "Chave da NASA",
      "type": "text",
      "default": "DEMO_KEY",
      "help": "DEMO_KEY funciona, com poucas chamadas por hora. Uma chave própria é grátis em api.nasa.gov."
    }
  ]
}
