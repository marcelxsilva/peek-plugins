{
  "schema": 8,
  "id": "plugin.exemplo.stripe",
  "name": "Stripe",
  "interval": 900,
  "icon": {
    "kind": "picture",
    "symbolName": "creditcard.fill",
    "pictureSource": "https://github.com/stripe.png?size=128"
  },
  "source": {
    "kind": "command",
    "steps": [
      {
        "program": "/usr/bin/env",
        "arguments": [
          "PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin",
          "stripe",
          "get",
          "/v1/balance",
          "{{$settings.modo}}"
        ]
      },
      {
        "program": "/usr/bin/jq",
        "arguments": [
          "{ disponivel: ((.available[0].amount // 0) / 100), pendente: ((.pending[0].amount // 0) / 100), moeda: ((.available[0].currency // \"usd\") | ascii_upcase) }"
        ]
      }
    ],
    "format": {
      "kind": "json"
    }
  },
  "slot": {
    "label": "{{disponivel | shape #,##0}}",
    "style": "sparkline"
  },
  "history": {
    "path": "disponivel",
    "keep": 96
  },
  "card": {
    "isEnabled": true,
    "title": "Stripe",
    "subtitle": "Saldo da conta",
    "blocks": [
      {
        "type": "hero",
        "value": "{{disponivel}}",
        "caption": "Disponível em {{moeda}}",
        "format": "money",
        "currency": "{{moeda}}",
        "goodDirection": "up",
        "width": "half"
      },
      {
        "type": "hero",
        "width": "half",
        "value": "{{pendente}}",
        "caption": "Pendente em {{moeda}}",
        "format": "money",
        "currency": "{{moeda}}",
        "goodDirection": "up"
      },
      {
        "type": "chart",
        "title": "Saldo ao longo do dia",
        "style": "area",
        "height": "medium",
        "format": "money",
        "currency": "{{moeda}}"
      }
    ]
  },
  "actions": [
    {
      "name": "Abrir o painel",
      "symbolName": "arrow.up.forward.square",
      "place": "card",
      "run": {
        "kind": "onTheMac",
        "errand": "openLink",
        "text": "https://dashboard.stripe.com/balance"
      },
      "successReport": "nothing"
    }
  ],
  "attention": {
    "mode": "never"
  },
  "settings": [
    {
      "key": "modo",
      "label": "Modo",
      "type": "choice",
      "default": "--live",
      "options": [
        {
          "value": "--live",
          "label": "Produção"
        },
        {
          "value": "--confirm",
          "label": "Teste"
        }
      ],
      "help": "Entre antes com stripe login no Terminal."
    }
  ]
}
