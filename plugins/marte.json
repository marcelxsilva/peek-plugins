{
  "schema": 5,
  "id": "plugin.exemplo.marte",
  "name": "Marte",
  "interval": 86400,
  "icon": {
    "kind": "picture",
    "symbolName": "camera.fill",
    "pictureSource": "https://github.com/nasa.png?size=128"
  },
  "source": {
    "kind": "http",
    "method": "GET",
    "url": "https://mars.nasa.gov/api/v1/raw_image_items/",
    "query": [
      {
        "name": "order",
        "value": "sol desc,date_taken desc"
      },
      {
        "name": "per_page",
        "value": "12"
      },
      {
        "name": "page",
        "value": "0"
      },
      {
        "name": "condition_1",
        "value": "msl:mission"
      },
      {
        "name": "extended",
        "value": "thumbnail::sample_type::noteq,"
      }
    ],
    "format": {
      "kind": "json"
    }
  },
  "slot": {
    "label": "{{items[0].sol}}",
    "style": "arc"
  },
  "card": {
    "isEnabled": true,
    "picture": {
      "kind": "address",
      "value": "{{items[0].https_url}}",
      "shape": "rounded",
      "scale": 2.2
    },
    "title": "Marte",
    "subtitle": "Fotos mais recentes do Curiosity, sol {{items[0].sol}}",
    "emptyMessage": "A NASA não respondeu.",
    "blocks": [
      {
        "type": "list",
        "limit": 6,
        "tabs": [
          {
            "title": "Fotos",
            "path": "items",
            "rowTitle": "{{title}}",
            "rowSubtitle": "{{date_taken | date}}",
            "rowImage": "{{https_url}}",
            "rowWrapsTitle": true,
            "rowURL": "https://mars.nasa.gov{{link}}"
          }
        ]
      }
    ]
  },
  "actions": [],
  "attention": {
    "mode": "never"
  }
}
